@prefix okf: <https://okf.atonagestao.com/ns/okf#> .
@prefix okft: <https://okf.atonagestao.com/ns/tbox-tatico#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

okft:FailureMode a owl:Class ;
    rdfs:label "MecanismoDePerda" .

okft:GrupoDeRisco a owl:Class ;
    rdfs:label "GrupoDeRisco" .

okft:RecommendedAction a owl:Class ;
    rdfs:label "Acao" .

okft:Task a owl:Class ;
    rdfs:label "Task" .

okft:TechnicalDocument a owl:Class ;
    rdfs:label "TechnicalDocument" .

okft:Trigger a owl:Class ;
    rdfs:label "Trigger" .

okft:actionPriority a owl:DatatypeProperty ;
    rdfs:label "action_priority" .

okft:afeta a owl:ObjectProperty ;
    rdfs:label "afeta" ;
    rdfs:subPropertyOf okf:arestaCausal .

okft:agrupa a owl:ObjectProperty ;
    rdfs:label "agrupa" .

okft:agrupadoEm a owl:ObjectProperty ;
    rdfs:label "agrupado_em" .

okft:aplicaAoGrupo a owl:ObjectProperty ;
    rdfs:label "aplica_ao_grupo" .

okft:bridgesToFailureMode a owl:DatatypeProperty ;
    rdfs:label "bridges_to_failure_mode" .

okft:causadoPorAcao a owl:ObjectProperty ;
    rdfs:label "causado_por_acao" .

okft:compoe a owl:ObjectProperty ;
    rdfs:label "compoe" ;
    rdfs:subPropertyOf okf:arestaCausal .

okft:constituicao a owl:DatatypeProperty ;
    rdfs:label "constituicao" .

okft:convergeEm a owl:ObjectProperty ;
    rdfs:label "converge_em" ;
    rdfs:subPropertyOf okf:arestaCausal .

okft:criticidadeLegal a owl:DatatypeProperty ;
    rdfs:label "criticidade_legal" .

okft:documenta a owl:ObjectProperty ;
    rdfs:label "documenta" .

okft:failureCause a owl:DatatypeProperty ;
    rdfs:label "causa" .

okft:failureEffect a owl:DatatypeProperty ;
    rdfs:label "efeito" .

okft:failureMode a owl:DatatypeProperty ;
    rdfs:label "mecanismo" .

okft:funcaoObjetivo a owl:DatatypeProperty ;
    rdfs:label "funcao_objetivo" .

okft:hasAcao a owl:ObjectProperty ;
    rdfs:label "acoes" .

okft:hasFailureMode a owl:ObjectProperty ;
    rdfs:label "mecanismos" .

okft:hasGrupoDeRisco a owl:ObjectProperty ;
    rdfs:label "grupos_risco" .

okft:hasLifeCyclePhase a owl:DatatypeProperty ;
    rdfs:label "lifeCyclePhase" .

okft:hasTaskSequence a owl:ObjectProperty ;
    rdfs:label "passos" .

okft:heuristicContext a owl:DatatypeProperty ;
    rdfs:label "contexto" .

okft:instanciadoPorFalhaDe a owl:ObjectProperty ;
    rdfs:label "instanciado_por_falha_de" .

okft:iso14224_causa a owl:DatatypeProperty ;
    rdfs:label "iso14224_causa" .

okft:iso14224_classe a owl:DatatypeProperty ;
    rdfs:label "iso14224_classe" .

okft:limiares a owl:DatatypeProperty ;
    rdfs:label "limiares" .

okft:mitiga a owl:ObjectProperty ;
    rdfs:label "mitiga" ;
    rdfs:subPropertyOf okf:arestaCausal .

okft:mitigadoPor a owl:ObjectProperty ;
    rdfs:label "mitigado_por" .

okft:monetaryImpact a owl:DatatypeProperty ;
    rdfs:label "monetary_impact" .

okft:monitoradoPor a owl:DatatypeProperty ;
    rdfs:label "monitorado_por" .

okft:nivelAlerta a owl:DatatypeProperty ;
    rdfs:label "nivel_alerta" .

okft:observableIndicator a owl:DatatypeProperty ;
    rdfs:label "indicador_observavel" .

okft:observavel a owl:DatatypeProperty ;
    rdfs:label "observavel" .

okft:order a owl:DatatypeProperty ;
    rdfs:label "order" .

okft:papelCausal a owl:DatatypeProperty ;
